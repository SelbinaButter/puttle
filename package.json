{
  "name": "daily-putting-puzzle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/generate.ts --missing",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run test/sim test/game",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:generation": "vitest run test/generation",
    "test:browser": "playwright test",
    "generate": "tsx scripts/generate.ts",
    "audit:archive": "tsx scripts/audit.ts",
    "audit:determinism": "tsx scripts/replay.ts 60",
    "review:archive": "tsx scripts/review.ts",
    "brand-assets": "tsx scripts/generate-brand-assets.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
